# AcadMap environment variables — template only. Copy to .env and fill in.
# Never put real credentials in this file: it is committed to the repository.

# Neon PostgreSQL connection string (free tier).
#
# Use the POOLED endpoint — the host with `-pooler` in it. Authentication opens a
# real connection per function invocation, and the direct endpoint runs out of
# connections long before the free tier's request limit does.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signing key for session cookies and password-reset tokens (Better Auth).
#
# Required: without it sign-up and sign-in fail. Any long random string will do —
# `openssl rand -base64 32`, or in Node:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Changing it signs everyone out and invalidates outstanding reset links, so set
# it once per environment and keep it. It must never reach the browser.
BETTER_AUTH_SECRET=

# The public URL of the deployment, used to build links in emails and to check
# the origin of auth requests. Locally this can be left blank (http://localhost:5173
# is assumed); in production set it to the real origin, e.g. https://acadmap.app
BETTER_AUTH_URL=


# API key for the hosted Better Auth dashboard (dash.better-auth.com).
#
# Issued by the dashboard when you create the project there, and read by the
# `dash()` plugin in api/_lib/auth.ts. Leave it blank and the dashboard simply
# cannot connect; nothing else in the app depends on it.
#
# Treat it as an admin credential, not a public identifier: it authorises the
# /api/auth/dash/* routes, which can list, export, create, ban, impersonate and
# delete accounts without a student session. Set it in the deployment's
# environment variables only, and rotate it in the dashboard if it is ever
# pasted into a screenshot, a chat or a commit.
BETTER_AUTH_API_KEY=

# The single account promoted to OWNER on registration (admin dashboard access).
# Register this email through the normal sign-up form; no admin password is
# stored in the environment.
OWNER_EMAIL=owner@example.com

# Only set this if the frontend is served from a different origin than the API.
# Leave empty for the normal single-Vercel-project deployment. When set it is
# also used to build the link in the password reset email.
APP_ORIGIN=

# Transactional email, used by the password reset link.
#
# Without both of these, /api/auth/request-reset answers 503 and the app says so
# instead of pretending an email was sent. MAIL_FROM must be on a domain you have
# verified with whichever provider you use.
#
# Set ONE of the two keys below. Brevo's free allowance is the larger of the two
# for daily transactional sending and it takes any verified sender; Resend is
# simpler to start with and its onboarding@resend.dev sender works for testing.
# Check both providers' current pricing pages before committing — the numbers
# move. If both keys are set, Brevo is used.
BREVO_API_KEY=
RESEND_API_KEY=

MAIL_FROM=AcadMap <no-reply@example.com>

# Optional reply-to on outgoing mail, if you want replies to reach you.
MAIL_REPLY_TO=


